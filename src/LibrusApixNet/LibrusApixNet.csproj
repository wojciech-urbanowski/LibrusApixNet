<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="../../Version.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>LibrusApixNet</PackageId>
    <Authors>LibrusApixNet contributors</Authors>
    <Description>Unofficial cross-platform .NET 10 port of RustySnek/librus-apix for Librus Synergia. Provides authentication, grades, attendance, timetables, messages and notifications.</Description>
    <PackageTags>librus;synergia;librus-apix;api;scraper;cross-platform</PackageTags>
    <PackageReleaseNotes>First stable release of the .NET 10 port of librus-apix 1.6.0 for Windows, Linux and macOS. Includes authentication and saved sessions, numeric and descriptive grades, attendance, timetables, homework, announcements, messages and notifications. Includes the beta fixes for API root login, Synergia session cookies and message notification links. Updated installation and publishing documentation for stable releases.</PackageReleaseNotes>
    <PackageProjectUrl>https://github.com/wojciech-urbanowski/LibrusApixNet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/wojciech-urbanowski/LibrusApixNet.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageOutputPath>$(MSBuildThisFileDirectory)../../artifacts/packages</PackageOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" Version="1.8.4" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../LICENSE" Pack="true" PackagePath="" />
    <None Include="../../NOTICE.md" Pack="true" PackagePath="" />
    <None Include="../../docs/NUGET.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

</Project>
